PUSHER_SCHEME=https
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CACHE_DB=1
REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_DB=0
# REDIS_PREFIX=
REDIS_QUEUE=default
REDIS_URL=
REDIS_USERNAME=
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=
