###############################################################################
# Aqdi (عقدي) Backend — environment template
#
# Copy to `.env` and fill in the values marked "OWNER: ...".
# The app runs FULLY in test-mode with the placeholders below (no real SMS,
# no real charges, no Firebase). It goes live the moment you paste real keys
# and flip the *_DRIVER values, without any code change.
###############################################################################

# ------------------------------------------------------------------ App -------
APP_NAME=Aqdi
APP_ENV=production                       # local | staging | production
APP_KEY=                                 # run: php artisan key:generate
APP_DEBUG=false                          # NEVER true in production
APP_URL=https://api.your-domain.com      # public base URL of this API
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=error                          # debug in local, error in production

# ------------------------------------------------------------- Database -------
# Production uses MySQL. (Local dev can use sqlite: DB_CONNECTION=sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aqdi                         # OWNER: your database name
DB_USERNAME=aqdi                         # OWNER: db user
DB_PASSWORD=                             # OWNER: db password
DB_FOREIGN_KEYS=true

# ------------------------------------------ Cache / Queue / Session -----------
SESSION_DRIVER=database                  # database or redis in production
SESSION_LIFETIME=120
QUEUE_CONNECTION=database                # database or redis (needs a queue worker)
CACHE_DRIVER=file                        # file, database, or redis (Laravel 10 reads CACHE_DRIVER, not CACHE_STORE)
BROADCAST_DRIVER=log                     # Laravel 10 reads BROADCAST_DRIVER, not BROADCAST_CONNECTION
FILESYSTEM_DISK=local

# Redis (only if you set the drivers above to "redis")
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------------------------------- Mail -------
MAIL_MAILER=smtp                         # "log" writes emails to the log instead
MAIL_HOST=smtp.your-provider.com         # OWNER: SMTP host
MAIL_PORT=587
MAIL_USERNAME=                           # OWNER: SMTP user
MAIL_PASSWORD=                           # OWNER: SMTP password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@contractejar.com
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------- Payments (Moyasar) --------
# PAYMENTS_DRIVER: "moyasar" (real gateway) or "test" (simulate a paid contract).
# Leave the secret key empty OR set PAYMENTS_DRIVER=test to run without charges.
# To GO LIVE: set PAYMENTS_DRIVER=moyasar and paste your live secret key.
PAYMENTS_DRIVER=moyasar
MOYASAR_SECRET_KEY=                       # OWNER: Moyasar secret key (sk_live_...)
MOYASAR_PUBLISHABLE_KEY=                  # OWNER: Moyasar publishable key (pk_live_...)
MOYASAR_BASE_URL=https://api.moyasar.com
MOYASAR_CURRENCY=SAR
MOYASAR_LOCALE=ar                         # hosted payment page language
MOYASAR_TEST_MODE=false                   # true forces simulation even with a key

# Where Moyasar sends the buyer back (front-end screens).
PAYMENT_FRONTEND_URL=https://app.your-domain.com
# Optional explicit templates ({uuid} is replaced with the contract uuid).
PAYMENT_SUCCESS_URL_TEMPLATE=
PAYMENT_ERROR_URL_TEMPLATE=
# Optional mobile deep links.
PAYMENT_APP_SUCCESS_URL_TEMPLATE=
PAYMENT_APP_ERROR_URL_TEMPLATE=

# ------------------------------------------------------ OTP / SMS -------------
# OTP_DRIVER: "log" (no SMS; code goes to log + sms_logs), "taqnyat", or "twilio".
# Leave as "log" for staging/QA. To GO LIVE pick a provider and fill its keys;
# if a provider's keys are missing the app safely falls back to "log".
OTP_DRIVER=taqnyat

# Taqnyat (primary SMS provider in KSA)
TAQNYAT_BEARER=                           # OWNER: Taqnyat API bearer token
TAQNYAT_SENDER=AqdiCo                      # OWNER: approved sender name
TAQNYAT_SMS_ID=25489                       # OWNER: Taqnyat template/sms id

# Twilio (alternative SMS provider) — only if OTP_DRIVER=twilio
TWILIO_SID=                                # OWNER: Twilio Account SID
TWILIO_TOKEN=                              # OWNER: Twilio Auth Token
TWILIO_PHONE=                              # OWNER: Twilio sending number (+E.164)

# OTP tuning (safe defaults; usually left as-is)
OTP_LENGTH=4
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_SEND_COOLDOWN_SECONDS=120
OTP_SEND_MAX_PER_HOUR=5

# --------------------------------------------- Firebase (push) ---------------
# Push is a NO-OP until a service-account JSON is present. Set FIREBASE_DISABLED
# =true to force no-op even if a file exists. To GO LIVE: upload the JSON and
# point FIREBASE_CREDENTIALS at it, set FIREBASE_PROJECT_ID, FIREBASE_DISABLED=false.
FIREBASE_DISABLED=true
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json  # OWNER: path to JSON
FIREBASE_PROJECT_ID=                       # OWNER: Firebase project id
FIREBASE_SECRET=                           # OWNER: legacy FCM server key (optional)
FIREBASE_EMPLOYEES_TOPIC=employees
FIREBASE_USERS_TOPIC=users
# Firebase Realtime DB (optional, used by SEO crawl status only)
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_ACCESS_TOKEN=

# --------------------------------------------- CORS / Front-end --------------
# Comma-separated domains that may hold a Sanctum session (no scheme).
SANCTUM_STATEFUL_DOMAINS=app.your-domain.com,dashboard.your-domain.com
FRONTEND_URL=https://app.your-domain.com          # customer front-end
DASHBOARD_URL=https://dashboard.your-domain.com   # admin dashboard
ADMIN_FRONTEND_URL=https://dashboard.your-domain.com

# --------------------------------------------- Google OAuth (optional) -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==============================================================================
# Keys below are every remaining env() reference in config/ and app/ (QA audit).
# All are OPTIONAL: leave empty to keep the defaults shown in config/*.php.
# ==============================================================================

# --- Third-party ads / marketing connectors (optional)
ADS_ATTRIBUTION_COOKIE=aqdi_first_touch
ADS_ATTRIBUTION_COOKIE_MINUTES=129600
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
LOOP_API_KEY=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
SNAPCHAT_ADS_ACCOUNT_ID=
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=
SNAPCHAT_ADS_REFRESH_TOKEN=
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
TWITTER_ADS_ACCESS_TOKEN=
TWITTER_ADS_ACCESS_TOKEN_SECRET=
TWITTER_ADS_ACCOUNT_ID=
TWITTER_ADS_BEARER_TOKEN=
TWITTER_ADS_CONSUMER_KEY=
TWITTER_ADS_CONSUMER_SECRET=

# --- SEO crawler / Google Search Console (optional)
GOOGLE_SEO_REDIRECT_URI=
SEO_CRAWL_BASE_URL=https://aqdi.sa
SEO_CRAWL_DELAY_MS=80
SEO_CRAWL_FIREBASE_PATH=seo_crawl/status
SEO_CRAWL_FIREBASE_PROGRESS_INTERVAL=1
SEO_CRAWL_FIREBASE_STATUS=true
SEO_CRAWL_MAX_PAGES=400
SEO_CRAWL_SLOW_MS=3000
SEO_CRAWL_TIMEOUT=20
SEO_CRAWL_USER_AGENT="AqdiSeoBot/1.0 (+https://aqdi.sa)"
SEO_CRAWL_WEAK_INBOUND=2

# --- Blog stats / content (optional)
BLOG_STATS_ACTIVE_CONTRACTS=+2M
BLOG_STATS_ACTIVE_USERS=+5M
BLOG_STATS_LEASED_UNITS=+3M
BLOG_WORDS_PER_MINUTE=200

# --- Auth / OTP tuning (optional, defaults shown)
ADMIN_ACCESS_TOKEN_TTL_SECONDS=43200
ADMIN_REFRESH_TOKEN_TTL_SECONDS=28800
API_KEY=
BCRYPT_ROUNDS=10
OTP_SEND_HTTP_DECAY_MINUTES=10
OTP_SEND_HTTP_MAX=5
OTP_VERIFY_HTTP_DECAY_MINUTES=1
OTP_VERIFY_HTTP_MAX=10
SANCTUM_EXPIRATION=2880
SESSION_CONNECTION=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_STORE=

# --- Laravel framework optional drivers (only if you switch driver)
ABLY_KEY=
ASSET_URL=
AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_SECRET_ACCESS_KEY=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# CACHE_PREFIX=
DATABASE_URL=
DB_ENCRYPT=yes
DB_SOCKET=
DB_TRUST_SERVER_CERTIFICATE=false
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
LOG_DEPRECATIONS_CHANNEL=null
# LOG_PAPERTRAIL_HANDLER=
LOG_SLACK_WEBHOOK_URL=
LOG_STDERR_FORMATTER=
MAILGUN_DOMAIN=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_SECRET=
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
MAIL_URL=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MYSQL_ATTR_SSL_CA=
PAPERTRAIL_PORT=
PAPERTRAIL_URL=
POSTMARK_TOKEN=
